---
import Header from '../components/Header.astro';
import SocialFooter from '../components/SocialFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeEn, { frontmatter as homeFrontmatterEn } from '../content/home.md';
import HomeKo, { frontmatter as homeFrontmatterKo } from '../content/home.ko.md';
---

<BaseLayout
  title={`${homeFrontmatterEn.title} | ${homeFrontmatterKo.title}`}
  description={homeFrontmatterEn.description}
>
  <Header current="home" />

  <main class="mx-auto max-w-[62rem]">
    <div data-lang="en">
      <HomeEn />
    </div>
    <div data-lang="ko">
      <HomeKo />
    </div>
  </main>

  <SocialFooter id="home-footer" />
</BaseLayout>
